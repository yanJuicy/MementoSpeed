{
  "manifest_version": 3,
  "name": "Memento Speed",
  "version": "1.0",
  "description": "Remember Youtbe Video Speed",
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
